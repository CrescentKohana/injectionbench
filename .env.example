# Copy to .env and fill in only the variables you need; every value defaults to empty or to the
# documented default in internal/config when unset. Never commit a real .env file.

# TypeSafe AI (Jev / System One judge). Required only for --judge jev or --judge any.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
INJECTIONBENCH_JEV_MODEL=

# OpenAI-compatible chat completions. Required only for --llm openai.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
